# =============================================================================
# Dorara backend — environment variables (copy to .env for local development)
# On Render, add these in the service's Environment tab. Never commit real values.
# =============================================================================

# ---------------------------- REQUIRED ---------------------------------------
NODE_ENV=production
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<pass>@<cluster>/dorara
# (required in production — there is no localhost fallback there)
MONGODB_URI=
# Long random strings (e.g. `openssl rand -hex 48`). Required in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Deployed frontend URL (used for email links and CORS). Extra origins: CORS_ORIGINS
CLIENT_URL=https://your-app.vercel.app
# Cookies: with the Vercel rewrite proxy the browser talks to your Vercel domain,
# so cookies are first-party. Use "lax" in that setup.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# ---------------------------- OPTIONAL: general -------------------------------
# PORT is provided by Render automatically.
# CORS_ORIGINS=https://preview-1.vercel.app,https://preview-2.vercel.app
# TRUST_PROXY defaults to true in production (needed behind Render's proxy).

# ---------------------------- OPTIONAL: AI ------------------------------------
# Vercel AI Gateway key. Without it, itineraries use the deterministic fallback.
AI_GATEWAY_API_KEY=
# Default stays openai/gpt-4o-mini. Free-tier-eligible models to try (confirm in
# your AI Gateway dashboard): google/gemini-2.5-flash, openai/gpt-oss-120b
AI_MODEL=openai/gpt-4o-mini
# TRIP_AI_TIMEOUT_MS=25000
# TRIP_GENERATE_DEADLINE_MS=28000

# ---------------------------- OPTIONAL: live flights + stays ------------------
# SerpApi (Google Flights + Google Hotels). Without a key: labelled demo data.
SERPAPI_API_KEY=
# Free plan: 250 searches/month, 50/hour. Live calls stop at 80% of the monthly limit.
# SERPAPI_MONTHLY_LIMIT=250
# SERPAPI_QUOTA_STOP_RATIO=0.8
# SERPAPI_HOURLY_LIMIT=40
# SERPAPI_DAILY_LIMIT=8
# Live-search caps per caller per day (cache hits never count):
# LIVE_SEARCH_GUEST_DAILY=3
# LIVE_SEARCH_USER_DAILY=10
# FLIGHTS_CACHE_TTL_HOURS=6
# HOTELS_CACHE_TTL_HOURS=12
# PROVIDER_TIMEOUT_MS=10000

# ---------------------------- OPTIONAL: images --------------------------------
# Pexels — destination hero images only (attribution shown). Without a key: no image.
PEXELS_API_KEY=

# ---------------------------- OPTIONAL: trip planner rate limits --------------
# TRIP_RATE_LIMIT_GUEST_PER_HOUR=10
# TRIP_RATE_LIMIT_USER_PER_HOUR=40

# ---------------------------- OPTIONAL: email (SMTP) --------------------------
# Not needed to sign in: login does not require a verified email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Dorara <no-reply@example.com>"
