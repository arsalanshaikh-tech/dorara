{
  "name": "dorara-backend",
  "version": "1.0.0",
  "description": "Dorara Travel backend — production-ready Express.js + MongoDB API that powers the Dorara Next.js frontend.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node ../database/seed",
    "seed:fresh": "node ../database/seed --fresh",
    "lint": "eslint .",
    "test": "node tests/run-all.js",
    "test:integration": "node --test tests/integration/tripPlanner.integration.js"
  },
  "keywords": [
    "dorara",
    "travel",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "Dorara",
  "license": "MIT",
  "dependencies": {
    "ai": "^7.0.31",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.14",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "cloudinary": "^2.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  }
}
