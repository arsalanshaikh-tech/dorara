# =============================================================================
# Dorara frontend (Next.js) — environment variables. Copy to .env.local for local development.
# On Vercel add these in Project -> Settings -> Environment Variables, then REDEPLOY
# (NEXT_PUBLIC_* values are baked in at build time).
# =============================================================================

# ---- REQUIRED for real data (server-side only; never exposed to the browser) ----
# The backend (Render) URL the /api/v1/* rewrite proxies to, no trailing slash.
# Local development example: http://localhost:5000
BACKEND_URL=

# ---- OPTIONAL (all safe to leave unset) ----
# Development only: serve the built-in demo plan instead of calling the backend.
# Production must NOT set this.
# NEXT_PUBLIC_USE_MOCKS=true

# Bypass the Vercel proxy and call the backend directly (cross-site cookies then need
# SameSite=None; Secure + CORS). Normally leave unset so requests stay first-party (/api/v1).
# NEXT_PUBLIC_API_BASE_URL=
